%%{
    let common = system.getScript("/common");
    let module = system.modules['/board/ram/serialRam/serialram'];
%%}

/*
 * RAM
 */

 % for(let i = 0; i < module.$instances.length; i++) {
    % let instance = module.$instances[i];
    % let config = module.getInstanceConfig(instance);
/* RAM Object - initialized during Ram_open() */
Ram_OspiPsramObject gRamObject_`config.sramName` =
{
    .ospiHandle = NULL,
};
% }

/* RAM Attrs */
% for (let i = 0; i < module.$instances.length; i++) {
    % let instance = module.$instances[i];
    % let config = module.getInstanceConfig(instance);
Ram_Attrs gRamAttrs_`config.sramName` =
{
    .ramName = "`config.sramName`",
    .ramSize = `config.sramSize`,
    .pageSize = `config.sramPageSize`,
    .manufacturerId = `config.sramManfId`,
    .deviceId = `config.sramDevId`,
};
% }

/* RAM DevConfig */

% for (let i = 0; i < module.$instances.length; i++) {
    % let instance = module.$instances[i];
    % let config = module.getInstanceConfig(instance);
    % const MR_MAX = 8;
    % let enabledMrs = [];
    % for (let j = 0; j < MR_MAX; j++) {
    %   if (config["mrEn" + j]) {
    %     enabledMrs.push({ addr: config["mrAddr" + j], val: config["mrVal" + j], width: parseInt(config["mrValWidth" + j]) });
    %   }
    % }
    % /* Determine the widest MR value width across all enabled MRs (for mrValWidth field) */
    % let mrValWidthMax = 1;
    % for (let k = 0; k < enabledMrs.length; k++) {
    %   if (enabledMrs[k].width > mrValWidthMax) { mrValWidthMax = enabledMrs[k].width; }
    % }
    % /* Map cmdExtType string to OSPI driver macro */
    % let cmdExtMacro = "OSPI_CMD_EXT_TYPE_NONE";
    % if (config.sramCmdExtType === "REPEAT")  { cmdExtMacro = "OSPI_CMD_EXT_TYPE_REPEAT"; }
    % if (config.sramCmdExtType === "INVERSE") { cmdExtMacro = "OSPI_CMD_EXT_TYPE_INVERSE"; }
    % if (enabledMrs.length > 0) {
Ram_MrConfig gRamMrConfig_`config.sramName`[] =
{
    % for (let k = 0; k < enabledMrs.length; k++) {
    { .address = `enabledMrs[k].addr`U, .value = `enabledMrs[k].val`U },
    % }
};
    % }
Ram_DevConfig gRamDevCfg_`config.sramName` =
{
    .cmdRd = `config.sramCmdRd`,
    .cmdWr = `config.sramCmdWr`,
    .cmdReset = `config.sramCmdReset`,
    .cmdRegRd = `config.sramCmdRegRd`,
    .cmdRegWr = `config.sramCmdRegWr`,
    .dummyClksRd = `config.sramDummyClksRd`,
    .dummyClksWr = `config.sramDummyClksWr`,
    .dummyClksCmd = `config.sramDummyClksCmd`,
    .cmdExtType = `cmdExtMacro`,
    % if (enabledMrs.length > 0) {
    .mrCount = `enabledMrs.length`,
    .mrValWidth = `mrValWidthMax`U,
    .mrConfig = gRamMrConfig_`config.sramName`,
    % } else {
    .mrCount = 0,
    .mrValWidth = 1U,
    .mrConfig = NULL,
    % }
};
% }