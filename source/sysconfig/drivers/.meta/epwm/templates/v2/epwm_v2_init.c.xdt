%%{
    let module = system.modules['/drivers/epwm/epwm'];
    let common = system.getScript("/common");
%%}
    /* EPWM */
    {
        /* Enable time base clock for the selected ePWM */
% if (module != null) {
    % for(let i = 0; i < module.$instances.length; i++) {
        % let instance = module.$instances[i];
        % let config = module.getInstanceConfig(instance);
        /* Enable peripheral clocks for `instance.$name` */
        % for(let clkIdx = 0; clkIdx < config.clockIds.length; clkIdx++) {
        SOC_rcmSetPeripheralClock(`config.clockIds[clkIdx]`, SOC_RcmPeripheralClockSource_SYS_CLK, `config.funcClk`U);
        % }
    % }
% }
    }