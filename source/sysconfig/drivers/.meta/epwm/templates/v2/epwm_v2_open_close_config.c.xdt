%%{
    let module = system.modules['/drivers/epwm/epwm'];
    let common = system.getScript("/common");
    
    function getClockDivValue(divString) {
        const divMap = {
            "EPWM_HSCLOCK_DIVIDER_1": 1,
            "EPWM_HSCLOCK_DIVIDER_2": 2,
            "EPWM_HSCLOCK_DIVIDER_4": 4,
            "EPWM_HSCLOCK_DIVIDER_6": 6,
            "EPWM_HSCLOCK_DIVIDER_8": 8,
            "EPWM_HSCLOCK_DIVIDER_10": 10,
            "EPWM_HSCLOCK_DIVIDER_12": 12,
            "EPWM_HSCLOCK_DIVIDER_14": 14,
            "EPWM_CLOCK_DIVIDER_1": 1,
            "EPWM_CLOCK_DIVIDER_2": 2,
            "EPWM_CLOCK_DIVIDER_4": 4,
            "EPWM_CLOCK_DIVIDER_8": 8,
            "EPWM_CLOCK_DIVIDER_16": 16,
            "EPWM_CLOCK_DIVIDER_32": 32,
            "EPWM_CLOCK_DIVIDER_64": 64,
            "EPWM_CLOCK_DIVIDER_128": 128
        };
        return divMap[divString] || 1;
    }
%%}

/*
 * EPWM v2 Driver Configuration
 * Auto-generated by SysConfig for AM273x
 */

#include <drivers/epwm.h>
#include <drivers/hw_include/hw_types.h>
#include <drivers/hw_include/cslr_epwm.h>

/* ========================================================================== */
/*                          Function Definitions                              */
/* ========================================================================== */

void Drivers_epwmOpen(void)
{
% if (module != null)
% {
    % for(let i = 0; i < module.$instances.length; i++) {
        % let instance = module.$instances[i];
        % let config = module.getInstanceConfig(instance);
    
    /* ========================================================================== */
    /*                    `instance.$name` Configuration                         */
    /* ========================================================================== */
    
    uint32_t baseAddr = `instance.$name`_BASE_ADDR;
    
    /* ========== TIME BASE CONFIGURATION ========== */
    
    /* Time Base Clock Configuration */
    {
        uint32_t tbClk;
        % let hspDiv = getClockDivValue(instance.epwmTimebase_hsClockDiv);
        % let clkDivVal = getClockDivValue(instance.epwmTimebase_clockDiv);
        % let totalDiv = hspDiv * clkDivVal;
        % // Prefer clockFrequencies[0].clkRate when available; fallback to config.funcClk
        % let funcClkVal = (config.clockFrequencies && config.clockFrequencies.length > 0) ? config.clockFrequencies[0].clkRate : config.funcClk;

        tbClk = `funcClkVal`U / `totalDiv`U;
        EPWM_tbTimebaseClkCfg(baseAddr, tbClk, `funcClkVal`U);
    }
    
    EPWM_tbPwmFreqCfg(baseAddr,
                      0U,
                      0U,
                      `instance.epwmTimebase_counterMode`,
                      `instance.epwmTimebase_periodLoadMode`);
    
    /* v2 has no setPeriod API, use register write */
    HW_WR_REG16(baseAddr + CSL_EPWM_TBPRD, `instance.epwmTimebase_period`U);
    
    /* Set Counter Initial Value */
    EPWM_tbWriteTbCount(baseAddr, `instance.epwmTimebase_counterValue`U);
    
    /* ========== SYNCHRONIZATION ========== */
    
    /* Sync Out Mode */
    EPWM_tbSetSyncOutMode(baseAddr, `instance.epwmTimebase_syncOutMode`);
    
    /* Phase Synchronization */
    % if(instance.epwmTimebase_phaseEnable) {
    EPWM_tbSyncEnable(baseAddr,
                      `instance.epwmTimebase_phaseShift`U,
                      `instance.epwmTimebase_counterModeAfterSync`);
    % } else {
    EPWM_tbSyncDisable(baseAddr);
    % }
    
    /* Force Sync Pulse */
    % if(instance.epwmTimebase_forceSyncPulse) {
    EPWM_tbTriggerSwSync(baseAddr);
    % }
    
    /* Emulation Mode */
    EPWM_tbSetEmulationMode(baseAddr, `instance.epwmTimebase_emulationMode`);
    
    /* ========== COUNTER COMPARE ========== */
    
    /* Counter Compare A */
    EPWM_counterComparatorCfg(baseAddr,
                              EPWM_CC_CMP_A,
                              `instance.epwmCounterCompare_cmpA`U,
                              `instance.epwmCounterCompare_enableShadowLoadModeCMPA ? "EPWM_SHADOW_REG_CTRL_ENABLE" : "EPWM_SHADOW_REG_CTRL_DISABLE"`,
                              `instance.epwmCounterCompare_shadowLoadModeCMPA`,
                              TRUE);
    
    /* Counter Compare B */
    EPWM_counterComparatorCfg(baseAddr,
                              EPWM_CC_CMP_B,
                              `instance.epwmCounterCompare_cmpB`U,
                              `instance.epwmCounterCompare_enableShadowLoadModeCMPB ? "EPWM_SHADOW_REG_CTRL_ENABLE" : "EPWM_SHADOW_REG_CTRL_DISABLE"`,
                              `instance.epwmCounterCompare_shadowLoadModeCMPB`,
                              TRUE);
    
    /* ========== ACTION QUALIFIER ========== */
    
    /* Output A Actions */
    {
        EPWM_AqActionCfg aqConfigA = {0};
        aqConfigA.zeroAction = `instance.epwmActionQualifier_EPWM_AQ_OUTPUT_A_ON_TIMEBASE_ZERO`;
        aqConfigA.prdAction = `instance.epwmActionQualifier_EPWM_AQ_OUTPUT_A_ON_TIMEBASE_PERIOD`;
        aqConfigA.cmpAUpAction = `instance.epwmActionQualifier_EPWM_AQ_OUTPUT_A_ON_TIMEBASE_UP_CMPA`;
        aqConfigA.cmpADownAction = `instance.epwmActionQualifier_EPWM_AQ_OUTPUT_A_ON_TIMEBASE_DOWN_CMPA`;
        aqConfigA.cmpBUpAction = `instance.epwmActionQualifier_EPWM_AQ_OUTPUT_A_ON_TIMEBASE_UP_CMPB`;
        aqConfigA.cmpBDownAction = `instance.epwmActionQualifier_EPWM_AQ_OUTPUT_A_ON_TIMEBASE_DOWN_CMPB`;
        EPWM_aqActionOnOutputCfg(baseAddr, EPWM_OUTPUT_CH_A, &aqConfigA);
    }
    
    /* Output B Actions */
    {
        EPWM_AqActionCfg aqConfigB = {0};
        aqConfigB.zeroAction = `instance.epwmActionQualifier_EPWM_AQ_OUTPUT_B_ON_TIMEBASE_ZERO`;
        aqConfigB.prdAction = `instance.epwmActionQualifier_EPWM_AQ_OUTPUT_B_ON_TIMEBASE_PERIOD`;
        aqConfigB.cmpAUpAction = `instance.epwmActionQualifier_EPWM_AQ_OUTPUT_B_ON_TIMEBASE_UP_CMPA`;
        aqConfigB.cmpADownAction = `instance.epwmActionQualifier_EPWM_AQ_OUTPUT_B_ON_TIMEBASE_DOWN_CMPA`;
        aqConfigB.cmpBUpAction = `instance.epwmActionQualifier_EPWM_AQ_OUTPUT_B_ON_TIMEBASE_UP_CMPB`;
        aqConfigB.cmpBDownAction = `instance.epwmActionQualifier_EPWM_AQ_OUTPUT_B_ON_TIMEBASE_DOWN_CMPB`;
        EPWM_aqActionOnOutputCfg(baseAddr, EPWM_OUTPUT_CH_B, &aqConfigB);
    }
    
    /* Software Force - One Time */
    % if(instance.epwmActionQualifier_EPWM_AQ_OUTPUT_A_swForceActionEnable) {
    EPWM_aqSwTriggerOneTimeAction(baseAddr,
                                  EPWM_OUTPUT_CH_A,
                                  `instance.epwmActionQualifier_EPWM_AQ_OUTPUT_A_swForceAction`);
    % }
    % if(instance.epwmActionQualifier_EPWM_AQ_OUTPUT_B_swForceActionEnable) {
    EPWM_aqSwTriggerOneTimeAction(baseAddr,
                                  EPWM_OUTPUT_CH_B,
                                  `instance.epwmActionQualifier_EPWM_AQ_OUTPUT_B_swForceAction`);
    % }
    
    /* Software Force - Continuous */
    % if(instance.epwmActionQualifier_EPWM_AQ_OUTPUT_A_continousSwForceAction != "EPWM_AQ_SW_TRIG_CONT_ACTION_NOEFFECT") {
    EPWM_aqSwTriggerContAction(baseAddr,
                               EPWM_OUTPUT_CH_A,
                               `instance.epwmActionQualifier_EPWM_AQ_OUTPUT_A_continousSwForceAction`,
                               `instance.epwmActionQualifier_continousSwForceReloadMode`);
    % }
    % if(instance.epwmActionQualifier_EPWM_AQ_OUTPUT_B_continousSwForceAction != "EPWM_AQ_SW_TRIG_CONT_ACTION_NOEFFECT") {
    EPWM_aqSwTriggerContAction(baseAddr,
                               EPWM_OUTPUT_CH_B,
                               `instance.epwmActionQualifier_EPWM_AQ_OUTPUT_B_continousSwForceAction`,
                               `instance.epwmActionQualifier_continousSwForceReloadMode`);
    % }
    
    /* ========== DEAD-BAND ========== */
    
    % if(instance.epwmDeadband_enableDeadBand) {
    {
        EPWM_DeadbandCfg dbConfig = {0};
        dbConfig.inputMode = `instance.epwmDeadband_inputMode`;
        dbConfig.outputMode = `instance.epwmDeadband_outputMode`;
        dbConfig.polaritySelect = `instance.epwmDeadband_polaritySelect`;
        dbConfig.risingEdgeDelay = `instance.epwmDeadband_risingEdgeDelay`U;
        dbConfig.fallingEdgeDelay = `instance.epwmDeadband_fallingEdgeDelay`U;
        EPWM_deadbandCfg(baseAddr, &dbConfig);
    }
    % } else {
    EPWM_deadbandBypass(baseAddr);
    % }
    
    /* ========== TRIP ZONE ========== */
    
    % if(instance.epwmTripZone_oneShotSource != 0 || instance.epwmTripZone_cbcSource != 0) {
    /* Trip Actions */
    EPWM_tzTriggerTripAction(baseAddr,
                             `instance.epwmTripZone_tzActionA`,
                             EPWM_OUTPUT_CH_A);
    EPWM_tzTriggerTripAction(baseAddr,
                             `instance.epwmTripZone_tzActionB`,
                             EPWM_OUTPUT_CH_B);
    
    /* Trip Events */
        % if(instance.epwmTripZone_oneShotSource != 0) {
    EPWM_tzTripEventEnable(baseAddr,
                           EPWM_TZ_EVENT_ONE_SHOT,
                           `instance.epwmTripZone_oneShotSource`U);
        % }
        % if(instance.epwmTripZone_cbcSource != 0) {
    EPWM_tzTripEventEnable(baseAddr,
                           EPWM_TZ_EVENT_CYCLE_BY_CYCLE,
                           `instance.epwmTripZone_cbcSource`U);
        % }
    
    /* Trip Interrupts */
        % if(instance.epwmTripZone_enableOSTIntr) {
    EPWM_tzIntrEnable(baseAddr, EPWM_TZ_EVENT_ONE_SHOT);
        % }
        % if(instance.epwmTripZone_enableCBCIntr) {
    EPWM_tzIntrEnable(baseAddr, EPWM_TZ_EVENT_CYCLE_BY_CYCLE);
        % }
    % }
    
    /* ========== EVENT TRIGGER ========== */
    
    % if(instance.epwmEventTrigger_enableInterrupt) {
    EPWM_etIntrCfg(baseAddr,
                   `instance.epwmEventTrigger_interruptSource`,
                   `instance.epwmEventTrigger_interruptPrescale`);
    EPWM_etIntrEnable(baseAddr);
    % }
    
    /* ========== CHOPPER ========== */
    
    % if(instance.epwmChopper_enableChopper) {
    {
        EPWM_ChopperCfg chopperConfig = {0};
        chopperConfig.dutyCycle = `instance.epwmChopper_dutyCycle`;
        chopperConfig.clkFrequency = `instance.epwmChopper_clkFreq`;
        chopperConfig.oneShotPulseWidth = `instance.epwmChopper_oneShotWidth`U;
        EPWM_chopperCfg(baseAddr, &chopperConfig);
        EPWM_chopperEnable(baseAddr, TRUE);
    }
    % }
    
    % } // End instance loop
% } // End module check
}

void Drivers_epwmClose(void)
{
    /* No cleanup needed for v2 */
}